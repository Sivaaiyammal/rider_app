<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    Having themes.xml for v35 variant because @android:windowOptOutEdgeToEdgeEnforcement
     requires API level 35
    -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <!-- Disable text selection/insertion handles to avoid Magnifier crashes on some devices -->
        <item name="android:textSelectHandle">@null</item>
        <item name="android:textSelectHandleLeft">@null</item>
        <item name="android:textSelectHandleRight">@null</item>
    </style>
</resources>