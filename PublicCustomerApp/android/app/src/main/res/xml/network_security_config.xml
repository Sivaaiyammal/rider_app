<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP for all local dev networks (any developer IP) -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- localhost -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- 192.168.x.x subnet — covers all home/office WiFi IPs -->
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">192.168.0.2</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.1.20</domain>
        <domain includeSubdomains="true">192.168.1.21</domain>
        <domain includeSubdomains="true">192.168.29.4</domain>
        <domain includeSubdomains="true">192.168.29.1</domain>
        <!-- 10.x.x.x subnet — covers corporate/hotspot networks -->
        <domain includeSubdomains="true">10.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.2</domain>
    </domain-config>
</network-security-config>